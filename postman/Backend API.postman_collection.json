            "url": {
              "raw": "{{base_url}}/categorias/{{categoriaId}}",
              "host": ["{{base_url}}"],
              "path": ["categorias", "{{categoriaId}}"]
            }
          }
        },
        {
          "name": "Eliminar categoría",
          "request": {
            "method": "DELETE",
            "header": [],
